# These experiment artifacts are byte-hashed; preserve their stored bytes on checkout.
tools/neural/gen2-cache-manifest.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/neural/gen3-cache-manifest.json -text
tools/neural/gen3-selection.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/neural/gen3-model-card.json -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
src/main/resources/data/icheme/neural/v3-general-gen3-factorized.json -text

# Every frozen population, per-case journal and bundled model artifact in this repository is identified by
# the SHA-256 of its bytes, and a campaign harness refuses to run when that hash does not match. On a
# core.autocrlf=true checkout git rewrites their line endings and every one of those assertions fails, on
# files whose committed blobs are correct. Pin the stored bytes instead.
*.jsonl -text
src/main/resources/data/icheme/neural/*.json -text
tools/transformer-promotion/inputs/warmup.json -text
tools/benchmark-population/v1/*.json -text
tools/benchmark-population/v1/**/*.json -text

# CoolProp fluid files (MIT) are stored as fetched, so their SHA-256 in the directory README stays verifiable.
src/test/resources/science/thermo/coolprop/** -text

# Backward-compatibility corpus images (batch 2026-10-26-backward-compat): frozen bytes the gates read.
src/test/resources/compat/**/*.dat binary
src/test/resources/compat/**/*.bin binary
src/test/resources/compat/**/*.snbt -text
