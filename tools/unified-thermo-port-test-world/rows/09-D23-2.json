{
  "id": "D23-2",
  "title": "D23-2: CO2 traces in LNG pass as particles or deposit by line speed (a pump at 0.25 and 2.5 m/s); a CO2-rich methane liquid vented to 1 atm turns to slush and blocks the bottom outlet at 0.5 solids (MAIN_ADAPTATION_PLAN, D23 row 2)",
  "blocks": {
    "G":   {"at": [20, 102, 84], "block": "generator"},
    "P1":  {"at": [21, 102, 84], "block": "pipe"},
    "T":   {"at": [22, 102, 84], "block": "reservoir", "aim": {"stand": [23, 100, 86]}},
    "Pt":  {"at": [22, 103, 84], "block": "pipe"},
    "Vt":  {"at": [22, 104, 84], "block": "void"},
    "Pb":  {"at": [22, 101, 84], "block": "pipe"},
    "Pb2": {"at": [22, 101, 85], "block": "pipe"},
    "U":   {"at": [22, 101, 86], "block": "pump", "facing": "south"},
    "Pp":  {"at": [22, 101, 87], "block": "pipe"},
    "Vp":  {"at": [22, 101, 88], "block": "void"},
    "G2":  {"at": [30, 102, 84], "block": "generator"},
    "Q1":  {"at": [31, 102, 84], "block": "pipe"},
    "T2":  {"at": [32, 102, 84], "block": "reservoir", "aim": {"stand": [33, 100, 86]}},
    "Qt":  {"at": [32, 103, 84], "block": "pipe"},
    "Wt":  {"at": [32, 104, 84], "block": "void"},
    "Qb":  {"at": [32, 101, 84], "block": "pipe"},
    "Qb2": {"at": [32, 101, 85], "block": "pipe"},
    "Wb":  {"at": [32, 101, 86], "block": "void"}
  },
  "steps": [
    {"op": "mark"},
    {"op": "note", "text": "part a: LNG with 0.5 % CO2 into a tank vented at the top; the bottom line is a pump"},
    {"op": "place", "ids": ["G", "U"]},
    {"op": "set", "id": "G", "mixture": "Pilot: LNG + 0.5 % CO2 (traces)", "pressure": 1200000, "temperatureK": 120},
    {"op": "set", "id": "U", "flow": 0.0005, "head": 500000},
    {"op": "place", "ids": ["T", "Vt", "Vp", "Pt", "Pb", "Pb2", "Pp", "P1"]},
    {"op": "wait", "s": 40},
    {"op": "read", "ids": ["T"], "views": ["overview", "organic", "solids", "outlets"], "tag": "slow"},
    {"op": "read", "ids": ["Pb2", "U"], "views": ["overview"], "tag": "slow"},
    {"op": "set", "id": "U", "flow": 0.005, "head": 500000},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["Pb2", "U", "Pp"], "views": ["overview", "solids"], "tag": "fast"},
    {"op": "read", "ids": ["T"], "views": ["overview", "solids", "outlets"], "tag": "fast"},
    {"op": "note", "text": "part b: CH4 + 30 % CO2 liquid fills a tank vented at the top; the feed is cut and the tank vents to 1 atm; then a bottom outlet"},
    {"op": "place", "ids": ["G2"]},
    {"op": "set", "id": "G2", "mixture": "Pilot: CH4 + 30 % CO2 (slush)", "pressure": 2000000, "temperatureK": 140},
    {"op": "place", "ids": ["Wt", "Qt", "Q1", "T2"]},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["T2"], "views": ["overview", "organic", "solids"], "tag": "fill"},
    {"op": "remove", "ids": ["Q1"]},
    {"op": "wait", "s": 30},
    {"op": "read", "ids": ["T2"], "views": ["overview", "organic", "solids"], "tag": "vented"},
    {"op": "place", "ids": ["Wb", "Qb2", "Qb"]},
    {"op": "wait", "s": 10},
    {"op": "read", "ids": ["T2"], "views": ["overview", "solids", "outlets"], "tag": "slush"},
    {"op": "read", "ids": ["Qb2"], "views": ["overview"], "tag": "slush"},
    {"op": "log", "grep": "fluid_island=|status=PHASE_HOLD", "tag": "D23-2"}
  ]
}
