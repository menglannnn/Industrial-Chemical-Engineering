{
  "id": "R8",
  "title": "A compressor on a frosted tank: N2 + 10 % CO2 tank at 300 kPa with frost, its top port to a compressor (ratio 3) into a closed second tank (E4 row 8)",
  "blocks": {
    "G":  {"at": [20, 101, 52], "block": "generator"},
    "P1": {"at": [21, 101, 52], "block": "pipe"},
    "Ta": {"at": [22, 101, 52], "block": "reservoir", "aim": {"stand": [22, 100, 54]}},
    "Pk": {"at": [22, 102, 52], "block": "pipe"},
    "K":  {"at": [22, 103, 52], "block": "compressor", "facing": "up", "aim": {"stand": [23, 102, 52]}},
    "S":  {"at": [23, 102, 52], "block": "glass"},
    "Pd": {"at": [22, 104, 52], "block": "pipe"},
    "Tb": {"at": [22, 105, 52], "block": "reservoir"}
  },
  "steps": [
    {"op": "mark"},
    {"op": "place", "ids": ["G"]},
    {"op": "set", "id": "G", "mixture": "Pilot: N2 + 10 % CO2", "pressure": 300000, "temperatureK": 160},
    {"op": "place", "ids": ["Ta", "P1"]},
    {"op": "wait", "s": 30},
    {"op": "read", "ids": ["Ta"], "views": ["overview", "solids"], "tag": "charged"},
    {"op": "note", "text": "the tank is closed off from its generator; the compressor is set before its discharge line exists"},
    {"op": "remove", "ids": ["P1"]},
    {"op": "place", "ids": ["S", "K", "Pk"]},
    {"op": "set", "id": "K", "flow": 0.05, "ratio": 3},
    {"op": "place", "ids": ["Tb", "Pd"]},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["Ta", "Tb"], "views": ["overview", "solids"], "tag": "blowdown"},
    {"op": "read", "ids": ["K"], "views": ["overview"], "tag": "blowdown"},
    {"op": "wait", "s": 40},
    {"op": "read", "ids": ["Ta", "Tb"], "views": ["overview", "solids"], "tag": "late"},
    {"op": "read", "ids": ["K"], "views": ["overview"], "tag": "late"},
    {"op": "log", "grep": "fluid_island=|status=PHASE_HOLD", "tag": "R8"}
  ]
}
