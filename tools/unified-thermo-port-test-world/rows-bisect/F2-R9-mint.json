{
  "id": "F2-R9-mint",
  "title": "F2 bisect: R2-R7-R9 traced at the pump right after it is placed, set and joined to its discharge (the pump junction mint)",
  "blocks": {
    "Gm": {"at": [22,102,28], "block": "generator"},
    "Pm": {"at": [23,102,28], "block": "pipe"},
    "T": {"at": [24,102,28], "block": "reservoir", "aim": {"stand": [25,100,30]}},
    "Pc": {"at": [24,102,27], "block": "pipe"},
    "Gc": {"at": [24,102,26], "block": "generator"},
    "Ps": {"at": [25,102,28], "block": "pipe"},
    "Vs": {"at": [26,102,28], "block": "void"},
    "Pt": {"at": [24,103,28], "block": "pipe"},
    "Vt": {"at": [24,104,28], "block": "void"},
    "Pb": {"at": [24,101,28], "block": "pipe"},
    "Pb2": {"at": [24,101,29], "block": "pipe"},
    "Pb3": {"at": [24,101,30], "block": "pipe"},
    "Vb": {"at": [24,101,31], "block": "void"},
    "U": {"at": [24,101,31], "block": "pump", "facing": "south"},
    "Pp": {"at": [24,101,32], "block": "pipe"},
    "Vp": {"at": [24,101,33], "block": "void"}
  },
  "steps": [
    {"op": "mark"},
    {"op": "note", "text": "the CO2 line Pc is set to 1 cm before its generator exists (a 5 cm line passes 1.06 kg/s of CO2, whose freezing heat boils the pool and chokes the vent)"},
    {"op": "place", "ids": ["Gm", "Pc"]},
    {"op": "set", "id": "Pc", "diameter": 0.01},
    {"op": "set", "id": "Gm", "mixture": "Methane", "pressure": 200000, "temperatureK": 115},
    {"op": "place", "ids": ["Vt", "Pt", "Pm", "T"]},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["T"], "views": ["overview", "organic", "outlets"], "tag": "fill"},
    {"op": "note", "text": "the methane feed is cut: the pool vents to 1 atm through the top"},
    {"op": "remove", "ids": ["Pm"]},
    {"op": "wait", "s": 10},
    {"op": "note", "text": "row 2: CO2 gas into the methane pool"},
    {"op": "place", "ids": ["Gc"]},
    {"op": "set", "id": "Gc", "mixture": "Carbon dioxide", "pressure": 250000, "temperatureK": 250},
    {"op": "wait", "s": 25},
    {"op": "read", "ids": ["T"], "views": ["overview", "organic", "vapor", "solids", "outlets"], "tag": "r2-30s"},
    {"op": "wait", "s": 30},
    {"op": "read", "ids": ["T"], "views": ["overview", "solids", "outlets"], "tag": "r2-60s"},
    {"op": "note", "text": "row 7: side and bottom outlets join the top vent"},
    {"op": "place", "ids": ["Vs", "Vb", "Pb3", "Pb2", "Ps", "Pb"]},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["T"], "views": ["overview", "solids", "outlets"], "tag": "r7"},
    {"op": "read", "ids": ["Pb3", "Ps"], "views": ["overview", "solids"], "tag": "r7"},
    {"op": "note", "text": "row 9: the bottom void becomes a pump line, first slow (0.0005 m3/s, 0.25 m/s), then 0.005 m3/s (2.5 m/s)"},
    {"op": "remove", "ids": ["Vb"]},
    {"op": "place", "ids": ["U"]},
    {"op": "trace", "kind": "f2", "id": "U"},
    {"op": "set", "id": "U", "flow": 0.0005, "head": 500000},
    {"op": "trace", "kind": "f2", "id": "U"},
    {"op": "place", "ids": ["Vp", "Pp"]},
    {"op": "trace", "kind": "f2", "id": "U"},
    {"op": "wait", "s": 20},
    {"op": "read", "ids": ["U", "Pb3"], "views": ["overview"], "tag": "r9-slow"},
    {"op": "trace", "kind": "f2", "id": "U"}
  ]
}
