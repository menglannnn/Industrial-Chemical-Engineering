+    /**
+     * Owner decision D34 (phase-ports batch, 2026-09-28): a phase holding less than this share of its node's total amount
+     * (moles, every phase and component counted, solids not) is a trace phase and does not exist: its material is folded
+     * into the node's remaining phases. The resolution the Newton states a node's composition to.
+     */
+    public static final double PHASE_TRACE_FRACTION=1e-9;
+    /**
+     * Folds trace phases in place (owner decisions D33, D34): nothing leaves the node and nothing is booked. A trace
+     * hydrocarbon liquid goes into the gas phase, a trace of free water into the gas as water vapour, and a trace gas
+     * phase into the liquids (its hydrocarbons into the hydrocarbon liquid, its water vapour into the free water). A phase
+     * is folded only when every component it holds has a receiving phase that is not itself a trace: a nitrogen bubble in
+     * a node of free water only has none (nitrogen does not dissolve in the model's free water) and stays. The flash is
+     * the one place this is decided ({@link #flashTP}); the reconstruction's restatement of a node reuses it. Returns
+     * whether anything moved. {@code water} is {free water, water vapour}.
+     */
+    public boolean foldTracePhases(double[] liquid,double[] vapor,double[] water) {
+        double nl=0,nh=0;for(double x:liquid)nl+=x;for(double x:vapor)nh+=x;
+        double nv=nh+water[1],nw=water[0],total=nl+nv+nw;
+        if(!(total>0))return false;
+        double limit=PHASE_TRACE_FRACTION*total;boolean moved=false;
+        if(nl>0&&nl<limit&&nv>=limit){for(int i=0;i<liquid.length;i++){vapor[i]+=liquid[i];liquid[i]=0;}moved=true;}
+        if(nw>0&&nw<limit&&nv>=limit){water[1]+=water[0];water[0]=0;moved=true;}
+        if(nv>0&&nv<limit&&(nh==0||nl>=limit)&&(water[1]==0||nw>=limit)) {
+            for(int i=0;i<vapor.length;i++){liquid[i]+=vapor[i];vapor[i]=0;}water[0]+=water[1];water[1]=0;moved=true;
+        }
+        return moved;
+    }
