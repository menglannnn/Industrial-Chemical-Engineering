+package com.wormzjl.createcheme.science.fluid.network;
+
+/** t19 instrumentation (never commit): appends lines to the file named by -Dt19trace=<path>. */
+final class T19Trace {
+    static final String PATH=System.getProperty("t19trace");
+    static final boolean ON=PATH!=null;
+    /** -Dt19old=true: the velocity cap as the old branch of the flow row (no cap mode, no cap transitions). */
+    static final boolean OLD=Boolean.getBoolean("t19old");
+    /** -Dt19fail=both|enter|mono|none: the failure cap correction variant. */
+    static final String FAIL=System.getProperty("t19fail","both");
+    /** -Dt19hybrid=true: open lines keep the old clamp row; a cap is stated only after a failed Newton. */
+    static final boolean HYBRID=Boolean.getBoolean("t19hybrid");
+    /** -Dt19escalate=true: every solve starts with the old clamp row; a failed Newton with a clamped line hands the cap
+     * decisions to the active set for the rest of the solve. */
+    static final boolean ESCALATE=Boolean.getBoolean("t19escalate");
+    private static java.io.PrintWriter out;
+    private T19Trace(){}
+    static synchronized void line(String text) {
+        if(!ON)return;
+        try{if(out==null)out=new java.io.PrintWriter(new java.io.FileWriter(PATH,true),true);}catch(java.io.IOException e){return;}
+        out.println(Thread.currentThread().getName()+" "+text);
+    }
+}
