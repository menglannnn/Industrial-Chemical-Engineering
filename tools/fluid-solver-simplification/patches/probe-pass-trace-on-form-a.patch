+                sb.append(String.format(java.util.Locale.ROOT,"  node %d id=%d kind=%s z=%.1f P=%.8g T=%.5f m=%.6g liqV=%.5g vapV=%.5g V=%.4g layout=%s%n",node,r.id(),r.kind(),r.elevation(),s.pressure(),s.temperature(),s.mass(),s.liquidVolume(),s.vaporVolume(),r.inventory().volume(),e.layout[node]==null?"none":String.valueOf(e.layout[node].size())));}
