index 00000000..edf5e309
--- /dev/null
+++ b/tools/jdk-determinism/winsweep/winsweep.sh
@@ -0,0 +1,89 @@
+#!/usr/bin/env bash
+# Windows cross-runtime determinism sweep (batch 2026-09-27-jdk-determinism). Git Bash. One Gradle invocation to build
+# (the fuzz runner's build: main + test classes, mod jar, the test task's JVM arguments and class path), then every check
+# runs Gradle-free under each JDK home given. The first JDK is the reference; every other runtime is compared with it.
+#
+#   winsweep.sh <out-dir> <jdk-home> [<jdk-home>...]
+#
+# Checks per runtime (see README.md): identity (vendor, VM, JIT; UseJVMCICompiler for GraalVM), MathSweep (which Math
+# functions differ from StrictMath on this runtime: the libm the product must not depend on), the fluid suites
+# (science.fluid, runtime.fluid, runtime.Fluid*Test; printed lines), chain-100 exact (FluidSolverRegressionTest), and the
+# placement-sequence fuzz in both distributions (first hold per seed). Then compare.js prints one table to
+# <out-dir>/table.md and exits non-zero on any real difference.
+#
+# Env: ROOT (worktree to test; default the one holding this script), SEEDS (default 1-200), THREADS (fuzz workers,
+#      default 4), FUZZ=0 (skip the fuzz), BUILD=auto|always|never (default auto: build when missing or stale),
+#      FUZZ_RUNNER (folder of the Gradle-free fuzz runner; default <ROOT>/tools/phase-ports-probes/fuzz-runner, else the
+#      claude/fuzz-runner worktree), JAVAC_HOME (compiles MiniLauncher and MathSweep; default C:/Program Files/Java/jdk-21.0.11).
+set -uo pipefail
+unset JAVA_TOOL_OPTIONS
+HERE=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
+ROOT=$(cd "${ROOT:-$HERE/../../..}" && pwd)
+[ $# -ge 2 ] || { sed -n 2,19p "$0"; exit 2; }
+OUTDIR=$1; shift
+mkdir -p "$OUTDIR"; OUTDIR=$(cd "$OUTDIR" && pwd)
+SEEDS=${SEEDS:-1-200}; THREADS=${THREADS:-4}; FUZZ=${FUZZ:-1}; BUILD=${BUILD:-auto}
+JAVAC_HOME=${JAVAC_HOME:-"C:/Program Files/Java/jdk-21.0.11"}
+if [ -z "${FUZZ_RUNNER:-}" ]; then
+  FUZZ_RUNNER="$ROOT/tools/phase-ports-probes/fuzz-runner"
+  [ -f "$FUZZ_RUNNER/build.sh" ] || FUZZ_RUNNER=/d/Minecraft/Modding/1.21/CreateChemE/.claude/worktrees/agent-a0fdb6ef46fa27b13/tools/phase-ports-probes/fuzz-runner
+fi
+FB="$ROOT/build/fuzz-runner"; WB="$ROOT/build/winsweep"
+PROBES="$ROOT/tools/phase-ports-probes"
+win() { cygpath -w "$1"; }
+
+# ---- build (one Gradle invocation) ------------------------------------------------------------------------------------
+stale=0
+[ -f "$FB/stamp" ] || stale=1
+[ $stale = 0 ] && [ -n "$(find "$ROOT/src" "$PROBES/hold-fuzz/src" "$PROBES/hold-classes/src" -type f -newer "$FB/stamp" 2>/dev/null | head -1)" ] && stale=1
+if [ "$BUILD" = always ] || { [ "$BUILD" = auto ] && [ $stale = 1 ]; }; then
+  echo "winsweep: building $ROOT (one Gradle invocation, $FUZZ_RUNNER/build.sh)"
+  bash "$FUZZ_RUNNER/build.sh" "$ROOT" || { echo "winsweep: build failed"; exit 2; }
+elif [ $stale = 1 ]; then echo "winsweep: build missing or stale and BUILD=never"; exit 2; fi
+mkdir -p "$WB/launcher" "$WB/mathsweep"
+junit=$(node "$HERE/argfile.js" "$FB/classpath.args" "$(win "$WB/launcher")" "$WB/classpath.args") || exit 2
+"$JAVAC_HOME/bin/javac" --release 21 -nowarn -d "$(win "$WB/launcher")" -cp "$junit" "$(win "$ROOT/tools/jdk-determinism/perf/src/MiniLauncher.java")" || exit 2
+"$JAVAC_HOME/bin/javac" --release 17 -nowarn -d "$(win "$WB/mathsweep")" "$(win "$ROOT/tools/jdk-determinism/src/MathSweep.java")" || exit 2
+WORKDIR=$(tr -d '\r\n' < "$FB/workdir.txt")
+PKG=com.wormzjl.createcheme
+# Probe classes the fuzz runner build compiles into the test output (not part of any suite): excluded by simple name.
+excl=$(find "$PROBES/hold-fuzz/src" "$PROBES/hold-classes/src" -name '*.java' -printf '%f\n' 2>/dev/null | sed -E 's/\.java$//' | sort -u | sed -E 's/^/exclude:.*\\./; s/$/$/' | tr '\n' ' ')
+fluidcls=$(cd "$ROOT/build/classes/java/test" && ls com/wormzjl/createcheme/runtime/Fluid*Test.class 2>/dev/null | sed -E 's#/#.#g; s#\.class$##; s#^#class:#' | tr '\n' ' ')
+HEAD=$(git -C "$ROOT" rev-parse --short HEAD)$(git -C "$ROOT" diff --quiet HEAD -- src || echo '+dirty')
+echo "root=$ROOT head=$HEAD seeds=$SEEDS threads=$THREADS fuzz=$FUZZ" > "$OUTDIR/sweep.txt"
+
+# ---- per runtime -------------------------------------------------------------------------------------------------------
+launch() {  # launch <java> <log> <extra -D/-X...> -- <main class and args...>
+  local j=$1 log=$2; shift 2; local opts=()
+  while [ $# -gt 0 ] && [ "$1" != -- ]; do opts+=("$1"); shift; done; shift
+  (cd "$WORKDIR" && "$j" @"$(win "$FB/jvm.args")" "${opts[@]}" @"$(win "$WB/classpath.args")" "$@") > "$log" 2>&1
+}
+i=0
+for home in "$@"; do
+  i=$((i+1)); j="$home/bin/java"
+  [ -x "$j" ] || [ -x "$j.exe" ] || { echo "winsweep: no java in $home"; exit 2; }
+  d="$OUTDIR/r$i"; mkdir -p "$d"
+  echo "$home" > "$d/home.txt"
+  "$j" -XshowSettings:properties -version > "$d/identity.txt" 2>&1
+  if ! grep -q 'OpenJ9' "$d/identity.txt"; then "$j" -XX:+PrintFlagsFinal -version 2>/dev/null | grep -E ' (UseJVMCICompiler|EnableJVMCI) ' >> "$d/identity.txt"; fi
+  graal=0; grep -qE 'UseJVMCICompiler +:?= true' "$d/identity.txt" && graal=1
+  echo "== r$i $(grep -m1 -E 'java.vm.name' "$d/identity.txt" | sed 's/.*= //') $(grep -m1 -E 'java.runtime.version' "$d/identity.txt" | sed 's/.*= //') graal=$graal"
+  "$j" -cp "$(win "$WB/mathsweep")" MathSweep > "$d/mathsweep.txt" 2>&1
+  gopts=(); [ $graal = 1 ] && gopts=(-Djdk.graal.PrintCompilation=true "-Djdk.graal.LogFile=$(win "$d/graal-compilation.log")")
+  # shellcheck disable=SC2086
+  launch "$j" "$d/suite.txt" "${gopts[@]}" -- MiniLauncher package:$PKG.science.fluid package:$PKG.runtime.fluid $fluidcls $excl
+  grep -m1 MINILAUNCHER "$d/suite.txt"
+  launch "$j" "$d/regression.txt" -Dfluid.regression.mode=exact -Dfluid.regression.capture=false -- MiniLauncher class:$PKG.fluid.benchmark.FluidSolverRegressionTest
+  grep -m1 -oE 'chain-100 vs reference: max deviation: state/moles [^ ]+' "$d/regression.txt"
+  if [ "$FUZZ" = 1 ]; then
+    for dist in random defaults; do
+      dflag=false; [ $dist = defaults ] && dflag=true
+      launch "$j" "$d/fuzz-$dist.java.txt" -DholdFuzz.seeds="$SEEDS" -DholdFuzz.threads="$THREADS" -DholdFuzz.slices=120 \
+        -DholdFuzz.verbose=false -DholdFuzz.strict=false -DholdFuzz.defaults=$dflag -DholdFuzz.out="$(win "$d/fuzz-$dist-report.txt")" \
+        -- FuzzRunnerLauncher "method:$PKG.runtime.fluid.HoldFuzzTest#placementSequenceFuzz"
+      bash "$PROBES/hold-fuzz/classify.sh" "$d/fuzz-$dist-report.txt" > /dev/null
+      grep -h '^SUMMARY' "$d/fuzz-$dist-report.txt" | cut -d' ' -f2-3
+    done
+  fi
+done
+node "$HERE/compare.js" "$OUTDIR" $i
diff --git a/tools/jdk-determinism/winsweep/argfile.js b/tools/jdk-determinism/winsweep/argfile.js
new file mode 100644
index 00000000..24f454a8
--- /dev/null
+++ b/tools/jdk-determinism/winsweep/argfile.js
@@ -0,0 +1,11 @@
+// winsweep helper: reads build/fuzz-runner/classpath.args (java @argfile: "-cp" then one quoted, backslash-escaped path
+// list), writes a copy with <dir> prepended to the class path, and prints the JUnit Platform jars of that class path
+// (';'-separated) for compiling the MiniLauncher.   node argfile.js <classpath.args> <dir-to-prepend> <out-argfile>
+const fs = require('fs');
+const [src, dir, out] = process.argv.slice(2);
+const lines = fs.readFileSync(src, 'utf8').replace(/\r/g, '').split('\n').filter(l => l.length);
+if (lines[0] !== '-cp' || !/^".*"$/.test(lines[1])) throw new Error('unexpected classpath.args format: ' + src);
+const cp = lines[1].slice(1, -1).replace(/\\(.)/g, '$1');
+const q = s => '"' + s.replace(/\\/g, '\\\\').replace(/"/g, '\\"') + '"';
+fs.writeFileSync(out, '-cp\n' + q(dir + ';' + cp) + '\n');
+console.log(cp.split(';').filter(p => /[\\/](junit-platform-(launcher|engine|commons)|opentest4j|apiguardian-api)-[^\\/]*\.jar$/.test(p)).join(';'));
diff --git a/tools/jdk-determinism/winsweep/compare.js b/tools/jdk-determinism/winsweep/compare.js
new file mode 100644
index 00000000..56dff554
--- /dev/null
+++ b/tools/jdk-determinism/winsweep/compare.js
@@ -0,0 +1,138 @@
+// winsweep comparison: reads <out>/r1..rN (r1 = reference runtime), prints a Markdown table to stdout and <out>/table.md,
+// details to <out>/details.txt, and exits 1 on any real difference (printed suite lines, failing tests, chain-100,
+// fuzz first holds that differ without a budget hold on either side).   node compare.js <out-dir> <N>
+const fs = require('fs'), path = require('path');
+const [out, nArg] = process.argv.slice(2); const N = +nArg;
+const rd = (d, f) => { const p = path.join(out, d, f); return fs.existsSync(p) ? fs.readFileSync(p, 'utf8').replace(/\r/g, '') : null; };
+const details = [];
+
+function identity(d) {
+  const t = rd(d, 'identity.txt') || '';
+  const prop = k => { const m = new RegExp('^\\s*' + k.replace(/\./g, '\\.') + ' = (.*)$', 'm').exec(t); return m ? m[1].trim() : ''; };
+  const vm = prop('java.vm.name'), ver = prop('java.runtime.version'), vendor = prop('java.vendor.version') || prop('java.vendor');
+  const major = parseInt(prop('java.specification.version'), 10);
+  const graal = /UseJVMCICompiler\s+=\s+true/.test(t);
+  let family;
+  if (/OpenJ9/.test(vm + prop('java.vm.vendor'))) family = `OpenJ9 ${major}`;
+  else if (graal) family = `GraalVM ${major} (Graal JIT)`;
+  else family = `HotSpot ${major}`;
+  return { name: `${vendor} ${ver}`.trim(), family, graal };
+}
+function jit(d, id) {
+  if (!id.graal) return id.family.startsWith('OpenJ9') ? 'OpenJ9 JIT' : 'C1/C2';
+  const log = rd(d, 'graal-compilation.log');
+  if (!log) return 'Graal (no compilation log)';
+  const lines = log.split('\n').filter(l => /^HotSpotCompilation-\d+/.test(l));
+  const sci = lines.filter(l => /^\S+\s+Lcom\/wormzjl\/createcheme\/science\//.test(l));
+  const facade = new Set(lines.map(l => l.split(/\s+/)).filter(w => /science\/math\/Deterministic(Math|Pow);/.test(w[1])).map(w => w[1].replace(/.*\//, '').replace(';', '') + '.' + w[2]));
+  return `Graal (JVMCI): ${lines.length} compilations, ${sci.length} of science/, facade compiled: ${[...facade].sort().join(' ') || 'none'}`;
+}
+function mathsweep(d) {
+  const t = rd(d, 'mathsweep.txt') || '';
+  const fns = []; let unstable = [];
+  for (const l of t.split('\n')) {
+    const w = l.trim().split(/\s+/);
+    if (w.length >= 7 && /^\d+$/.test(w[1]) && /^[a-z0-9]+$/.test(w[0])) { if (+w[1] > 0) fns.push(w[0]); if (w[6] === 'NO') unstable.push(w[0]); }
+  }
+  return (fns.length ? fns.join(',') : 'none') + (unstable.length ? ` (tier-dependent: ${unstable.join(',')})` : '');
+}
+const normReasons = l => l.replace(/reasons=\{([^}]*)\}/g, (m, inner) => 'reasons={' + inner.split(/, (?=[^,]*=\d+(?:, |$))/).sort().join(', ') + '}');
+function suite(d) {
+  const t = rd(d, 'suite.txt'); if (!t) return null;
+  const all = t.split('\n');
+  const cut = all.findIndex(l => /^Failures \(\d+\):/.test(l) || /^MINILAUNCHER /.test(l));
+  const body = (cut < 0 ? all : all.slice(0, cut));
+  const summary = (all.find(l => /^MINILAUNCHER /.test(l)) || '').replace(/ wallMs=\d+/, '');
+  const failures = all.filter(l => /^\s+JUnit Jupiter:/.test(l)).map(l => l.trim());
+  const failSet = [...new Set(failures)].sort();
+  const printed = [], timing = [];
+  for (let l of body) {
+    if (/^\[Use -Djdk\.graal/.test(l)) continue;
+    l = l.replace(/ ms=[0-9.]+/g, ' ms=*').replace(/ allocatedMB=[0-9.]+/g, ' allocatedMB=*').replace(/ bytes=[0-9]+/g, ' bytes=*').replace(/wall(Ms|Nanos)?=[0-9.]+/g, 'wall=*');
+    // A wall-time line: a number followed by the unit ms (not a masked "ms=*" field), or a nanosecond count.
+    if (/\d ?ms\b(?!=)|Nanos=\d|median ms/.test(l)) { timing.push(l); continue; }
+    printed.push(l);
+  }
+  return { summary, failSet, printed, timing };
+}
+function chain(d) {
+  const t = rd(d, 'regression.txt') || '';
+  const dev = (/chain-100 vs reference: (.*)/.exec(t) || [, 'no chain-100 line'])[1].trim();
+  const row = (/^\s*\| 0 \|(.*)$/m.exec(t) || [, ''])[1].split('|').map(s => s.trim());
+  const counts = row.length > 10 ? `accepted=${row[2]} rejected=${row[3]} solves=${row[6]} iterations=${row[7]} residualEvaluations=${row[9]}` : 'no table row';
+  const moles = (/state\/moles (\S+)/.exec(dev) || [, '?'])[1];
+  return { dev, counts, moles };
+}
+const fcls = s => {
+  if (/^HELD \(thermo domain\)/.test(s)) return 'C';
+  if (/^HELD: wall deadline/.test(s) || /^HELD: soft budget/.test(s)) return 'F';
