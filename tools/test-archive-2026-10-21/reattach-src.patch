+    private static int same(double[] expected, double[] actual, String what) {
+        for (int i = 0; i < expected.length; i++) same(expected[i], actual[i], what + "[" + i + "]");
+        return expected.length;
+    }
+
+    private static int same(double expected, double actual, String what) {
