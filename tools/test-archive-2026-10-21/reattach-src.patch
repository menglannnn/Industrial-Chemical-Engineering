+                if (!(state.fractions[j] > 10 * MOLE_STEP) || !state.keepsRoot(evaluator, root, 0, 0, j + 1)) continue;
+                var higher = state.at(evaluator, root, 0, 0, j + 1);
+                var lower = state.at(evaluator, root, 0, 0, -(j + 1));
